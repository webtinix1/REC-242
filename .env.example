# Base de données PostgreSQL
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/rec242
# Secret de chiffrement des jetons Payload (chaîne aléatoire de 32 caractères au moins, différente par environnement).
# En production, le serveur refuse de démarrer avec la valeur d’exemple ou un secret plus court.
PAYLOAD_SECRET=a-remplacer
# URL publique du site, sans barre finale
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# E-mails (en développement : Mailpit, interface sur http://localhost:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=contact@rec242.cg
EMAIL_FROM_NAME=REC 242
# Mot de passe des comptes de démonstration (développement uniquement)
SEED_PASSWORD=
# Le seed est refusé avec NODE_ENV=production, sauf SEED_EN_PRODUCTION=oui et SEED_PASSWORD de 12 caractères au moins.
# SEED_EN_PRODUCTION=
# Paiement mobile (docs/02-architecture.md) : simulation, test (bacs à sable) ou production.
# Vide : simulation en développement, production avec NODE_ENV=production (opérateur indisponible sans clés).
# En simulation, tout paiement passe « payé » sans prélèvement : avec NODE_ENV=production, elle n'est acceptée que si
# NEXT_PUBLIC_SERVER_URL est locale (localhost, 127.0.0.1 ou [::1]) ; un serveur public la refuse avec une erreur.
# Ne décommentez la ligne suivante que pour un essai local (par exemple `next start` sur http://localhost:3000).
# PAIEMENT_MODE=simulation
# MTN MoMo, API Collection (https://momodeveloper.mtn.com)
MTN_BASE_URL=
MTN_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
MTN_TARGET_ENV=sandbox
MTN_CURRENCY=
# Airtel Money, API Collection (https://developers.airtel.africa)
AIRTEL_BASE_URL=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=CG
AIRTEL_CURRENCY=XAF

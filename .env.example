# Base de données PostgreSQL
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/rec242
# Secret de chiffrement des jetons Payload (chaîne aléatoire longue, différente par environnement)
PAYLOAD_SECRET=a-remplacer
# URL publique du site, sans barre finale
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# E-mails (en développement : Mailpit, interface sur http://localhost:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=contact@rec242.cg
EMAIL_FROM_NAME=REC 242
# Mot de passe des comptes de démonstration (développement uniquement)
SEED_PASSWORD=
# Paiement mobile (docs/02-architecture.md) : simulation (défaut en développement), test (bacs à sable) ou production.
# Sans clés, un opérateur reste en simulation hors production ; en production il est indisponible.
PAIEMENT_MODE=simulation
# MTN MoMo, API Collection (https://momodeveloper.mtn.com)
MTN_BASE_URL=
MTN_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
MTN_TARGET_ENV=sandbox
MTN_CURRENCY=
# Airtel Money, API Collection (https://developers.airtel.africa)
AIRTEL_BASE_URL=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=CG
AIRTEL_CURRENCY=XAF
